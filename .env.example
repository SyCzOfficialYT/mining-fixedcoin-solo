# FixedCoin Solo
FIX_RPCUSER=fixrpc
# Leave FIX_RPCPASS empty. Docker generates a strong secret on first start
# and stores it only inside the persistent fix-data volume.
FIX_RPCPASS=
# Leave empty. Docker creates the mining wallet and payout address automatically.
FIX_PAYOUT_ADDRESS=
FIX_RPCPORT=24761
FIX_P2PPORT=24768
FIX_DASH_PORT=5050
COINBASE_MATURITY=100

# NerdQAxe / AxeOS-style Discord incoming webhook
# Leave empty to disable notifications.
GHOSTBOT_WEBHOOK_URL=
GHOSTBOT_WEBHOOK_USERNAME=NerdQAxe++
GHOSTBOT_WEBHOOK_AVATAR_URL=
GHOSTBOT_WEBHOOK_TIMEOUT=5
GHOSTBOT_EMBED_COLOR=5635925
# Optional dashboard URL shown as the embed link.
GHOSTBOT_DASHBOARD_URL=
